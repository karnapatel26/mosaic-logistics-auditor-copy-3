# Upstash Redis REST URL used by the Next.js serverless cache layer.
# Leave blank for local memory fallback during development.
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token paired with UPSTASH_REDIS_REST_URL.
# Never commit a real token.
UPSTASH_REDIS_REST_TOKEN=

# Optional bearer token if /api/cron authorization is enabled in Vercel.
CRON_SECRET=
